# ── Database ──
DATABASE_URL="file:./prisma/dev.db?connection_limit=1"

# ── Auth ──
JWT_SECRET="change-me-in-production"

# ── Admin ──
ADMIN_EMAIL="admin@lifetide.ai"
NEXT_PUBLIC_ADMIN_EMAIL="admin@lifetide.ai"

# ── AI provider ──
AI_PROVIDER="aiping"
AIPING_API_KEY="your-aiping-key"
AIPING_BASE_URL="https://aiping.cn/api/v1"
AIPING_MODEL="Qwen3.7-Plus"

# Lightweight multimodal model for PDF/image text extraction.
MULTIMODAL_MODEL="Qwen3.5-Flash"

# ── GitHub (for star button) ──
NEXT_PUBLIC_GITHUB_URL="https://github.com/Haaaiawd/lifetide-lite"
